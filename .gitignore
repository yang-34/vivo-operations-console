# Existing top-level docs are private research and real-account audit reports.
# Put future public guides in docs/public/ after reviewing their contents.
/docs/*.md
/docs/*.json

# Operator scripts are private by default; keep the reusable offline/runtime tools.
/scripts/*
!/scripts/vivo-account-identity.js
!/scripts/vivo-browser-identity.js
!/scripts/vivo-native-identity.js
!/scripts/inspect_har_contracts.py
!/scripts/check_taskflow_integration.py
!/scripts/benchmark_async.py
!/scripts/benchmark_task_center.py
!/scripts/capture-readme-screenshots.mjs
!/scripts/public/

# Screenshots can expose accounts, addresses, passwords and voucher codes.
# Only these reviewed, isolated-demo screenshots are approved for publication.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.bmp
*.mp4
*.webm
